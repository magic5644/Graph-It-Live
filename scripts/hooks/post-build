#!/bin/bash
# Post-build hook for Graph-It-Live
# Verifies WASM files and query files copied correctly

set -e

echo "🔍 Post-build verification..."

# Check dist/wasm/ directory exists
if [ ! -d "dist/wasm" ]; then
  echo "❌ FAIL: dist/wasm/ directory not found"
  echo "Build may have failed or copyWasmFiles() not executed"
  exit 1
fi

# Check WASM files
echo "Checking WASM files..."
WASM_FILES=(tree-sitter.wasm tree-sitter-typescript.wasm tree-sitter-python.wasm
  tree-sitter-rust.wasm tree-sitter-c_sharp.wasm tree-sitter-go.wasm tree-sitter-java.wasm sqljs.wasm)
for file in "${WASM_FILES[@]}"; do
  if [ ! -s "dist/wasm/$file" ]; then
    echo "❌ FAIL: Missing or empty dist/wasm/$file"
    exit 1
  fi
done
echo "✅ All ${#WASM_FILES[@]} WASM files present"

# Check query files
echo "Checking query files..."
QUERY_COUNT=0
for source in resources/queries/*.scm; do
  destination="dist/queries/${source##*/}"
  if ! cmp -s "$source" "$destination"; then
    echo "❌ FAIL: Missing or outdated $destination (source: $source)"
    exit 1
  fi
  QUERY_COUNT=$((QUERY_COUNT + 1))
done
echo "✅ All $QUERY_COUNT query files match their sources"

# List built bundles
echo ""
echo "📦 Build output:"
ls -lh dist/*.{js,mjs} 2>/dev/null | awk '{printf "  %s - %s\n", $9, $5}'

echo ""
echo "✅ Post-build verification passed"
echo "✅ Build artifacts ready"
